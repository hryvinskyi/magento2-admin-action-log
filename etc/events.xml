<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="model_save_before">
        <observer name="hryvinskyi_admin_action_log_snapshot" instance="Hryvinskyi\AdminActionLog\Observer\EntityChange\SnapshotBeforeSave"/>
    </event>
    <event name="model_delete_before">
        <observer name="hryvinskyi_admin_action_log_snapshot" instance="Hryvinskyi\AdminActionLog\Observer\EntityChange\SnapshotBeforeDelete"/>
    </event>
    <event name="model_save_commit_after">
        <observer name="hryvinskyi_admin_action_log_record" instance="Hryvinskyi\AdminActionLog\Observer\EntityChange\RecordCommittedChange"/>
    </event>
    <event name="model_delete_commit_after">
        <observer name="hryvinskyi_admin_action_log_record" instance="Hryvinskyi\AdminActionLog\Observer\EntityChange\RecordCommittedChange"/>
    </event>
</config>
