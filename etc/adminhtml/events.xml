<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="controller_front_send_response_before">
        <observer name="hryvinskyi_admin_action_log_finish" instance="Hryvinskyi\AdminActionLog\Observer\AdminRequest\FinishAdminRequest"/>
    </event>
    <event name="backend_auth_user_login_success">
        <observer name="hryvinskyi_admin_action_log_login" instance="Hryvinskyi\AdminActionLog\Observer\AdminRequest\RecordLogin"/>
    </event>
    <event name="backend_auth_user_login_failed">
        <observer name="hryvinskyi_admin_action_log_login_failed" instance="Hryvinskyi\AdminActionLog\Observer\AdminRequest\RecordFailedLogin"/>
    </event>
</config>
