<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Inside the admin authentication plugin (sortOrder 100): only requests of a signed-in admin reach it -->
    <type name="Magento\Backend\App\AbstractAction">
        <plugin name="hryvinskyi_admin_action_log_request" type="Hryvinskyi\AdminActionLog\Plugin\Backend\RecordAdminRequest" sortOrder="200"/>
    </type>
    <type name="Hryvinskyi\AdminActionLog\Plugin\Backend\RecordAdminRequest">
        <arguments>
            <argument name="journal" xsi:type="object">Hryvinskyi\AdminActionLog\Model\AdminRequest\AdminRequestJournal\Proxy</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\AdminActionLog\Observer\AdminRequest\FinishAdminRequest">
        <arguments>
            <argument name="journal" xsi:type="object">Hryvinskyi\AdminActionLog\Model\AdminRequest\AdminRequestJournal\Proxy</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Message\ManagerInterface">
        <plugin name="hryvinskyi_admin_action_log_message" type="Hryvinskyi\AdminActionLog\Plugin\Message\CaptureAdminMessage"/>
    </type>
    <type name="Magento\Backend\Model\Auth">
        <plugin name="hryvinskyi_admin_action_log_logout" type="Hryvinskyi\AdminActionLog\Plugin\Backend\RecordLogout"/>
    </type>
    <virtualType name="Hryvinskyi\AdminActionLog\Block\Adminhtml\System\Config\IgnoredRouteList"
                 type="Hryvinskyi\ConfigurationFields\Block\Adminhtml\System\Config\Form\Field\TagList">
        <arguments>
            <argument name="tagListConfig" xsi:type="array">
                <item name="placeholder" xsi:type="string" translatable="true">Add a route pattern and press Enter</item>
                <item name="validation" xsi:type="string">^[A-Za-z0-9_*/]+$</item>
                <item name="uppercase" xsi:type="boolean">false</item>
                <item name="separator" xsi:type="string">,</item>
            </argument>
        </arguments>
    </virtualType>
</config>
