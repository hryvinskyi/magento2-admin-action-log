    </virtualType>
    <type name="Hryvinskyi\ActivityLog\Model\Channel\ChannelPool">
        <arguments>
            <argument name="channels" xsi:type="array">
                <item name="admin" xsi:type="object" sortOrder="20">Hryvinskyi\AdminActionLog\Model\Channel\AdminChannel</item>
                <item name="entity" xsi:type="object" sortOrder="30">Hryvinskyi\AdminActionLog\Model\Retention\EntityChannel</item>
            </argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\ActivityLog\Cron\ApplyRetention">
        <arguments>
