                <item name="entity_change" xsi:type="object" sortOrder="100">Hryvinskyi\AdminActionLog\Model\Retention\EntityChangePurger</item>
            </argument>
        </arguments>
    </type>

    <!-- Observers and plugins run on every save; what they need is built on the first save worth recording -->
    <type name="Hryvinskyi\AdminActionLog\Observer\EntityChange\SnapshotBeforeSave">
        <arguments>
            <argument name="journal" xsi:type="object">Hryvinskyi\AdminActionLog\Model\EntityChange\EntityChangeJournal\Proxy</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\AdminActionLog\Observer\EntityChange\SnapshotBeforeDelete">
        <arguments>
            <argument name="journal" xsi:type="object">Hryvinskyi\AdminActionLog\Model\EntityChange\EntityChangeJournal\Proxy</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\AdminActionLog\Observer\EntityChange\RecordCommittedChange">
        <arguments>
            <argument name="journal" xsi:type="object">Hryvinskyi\AdminActionLog\Model\EntityChange\EntityChangeJournal\Proxy</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\AdminActionLog\Plugin\Config\SnapshotEncryptedValue">
        <arguments>
            <argument name="journal" xsi:type="object">Hryvinskyi\AdminActionLog\Model\EntityChange\EntityChangeJournal\Proxy</argument>
        </arguments>
    </type>
    <type name="Magento\Config\Model\Config\Backend\Encrypted">
        <plugin name="hryvinskyi_admin_action_log_snapshot" type="Hryvinskyi\AdminActionLog\Plugin\Config\SnapshotEncryptedValue"/>
    </type>

