    <virtualType name="Hryvinskyi\AdminActionLog\Model\Channel\AdminChannel" type="Hryvinskyi\ActivityLog\Model\Channel\Channel">
        <arguments>
            <argument name="code" xsi:type="const">Hryvinskyi\AdminActionLog\Model\ChannelCode::ADMIN</argument>
            <argument name="label" xsi:type="string">Admin request</argument>
            <argument name="chartColor" xsi:type="string">#44AA99</argument>
