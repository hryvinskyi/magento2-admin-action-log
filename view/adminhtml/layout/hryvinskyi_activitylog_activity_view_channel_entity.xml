<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Hryvinskyi_AdminActionLog::css/admin-action-log.css"/>
    </head>
    <body>
        <referenceBlock name="activity.channel.fallback" remove="true"/>
        <referenceContainer name="activity.channel.panel">
            <block class="Magento\Framework\View\Element\Template" name="admin.action.log.entity.panel"
                   template="Hryvinskyi_AdminActionLog::activity/entity-change.phtml">
                <arguments>
                    <argument name="panel" xsi:type="object">Hryvinskyi\AdminActionLog\ViewModel\EntityChangePanel</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
