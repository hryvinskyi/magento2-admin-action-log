<!-- Entries of this module in the Activity Log menu -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="hryvinskyi.activity.log.menu">
            <arguments>
                <argument name="items" xsi:type="array">
                    <item name="admin_requests" xsi:type="array">
                        <item name="label" xsi:type="string" translate="true">Admin Requests</item>
                        <item name="route" xsi:type="string">activitylog/activity/index</item>
                        <item name="route_params" xsi:type="array">
                            <item name="_query" xsi:type="array">
                                <item name="channel" xsi:type="string">admin</item>
                            </item>
                        </item>
                        <item name="resource" xsi:type="string">Hryvinskyi_ActivityLog::view</item>
                        <item name="sort_order" xsi:type="number">25</item>
                        <item name="icon" xsi:type="string"><![CDATA[<svg class="menu-item-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 9h18M8 14h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>]]></item>
                    </item>
                    <item name="entity_changes" xsi:type="array">
                        <item name="label" xsi:type="string" translate="true">Entity Changes</item>
                        <item name="route" xsi:type="string">activitylog/activity/index</item>
                        <item name="route_params" xsi:type="array">
                            <item name="_query" xsi:type="array">
                                <item name="channel" xsi:type="string">entity</item>
                            </item>
                        </item>
                        <item name="resource" xsi:type="string">Hryvinskyi_ActivityLog::view</item>
                        <item name="sort_order" xsi:type="number">30</item>
                        <item name="icon" xsi:type="string"><![CDATA[<svg class="menu-item-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 7h10M4 12h16M4 17h7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M17 4l3 3-3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>]]></item>
                    </item>
                    <item name="admin_action_settings" xsi:type="array">
                        <item name="label" xsi:type="string" translate="true">Admin Logging Settings</item>
                        <item name="route" xsi:type="string">adminhtml/system_config/edit</item>
                        <item name="route_params" xsi:type="array">
                            <item name="section" xsi:type="string">hryvinskyi_admin_action_log</item>
                        </item>
                        <item name="resource" xsi:type="string">Hryvinskyi_AdminActionLog::config</item>
                        <item name="sort_order" xsi:type="number">120</item>
                        <item name="icon" xsi:type="string"><![CDATA[<svg class="menu-item-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>]]></item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
