{
    "name": "hryvinskyi/magento2-admin-action-log",
    "description": "Records admin requests and entity changes (before and after, per field) into the activity log journal",
    "type": "magento2-module",
    "version": "1.2.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "hryvinskyi/magento2-activity-log": "^1.1",
        "hryvinskyi/magento2-base": "^2.2",
        "hryvinskyi/magento2-configuration-fields": "^1.0.11",
        "magento/framework": "*",
        "magento/module-authorization": "*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-inventory": "*",
        "magento/module-catalog-rule": "*",
        "magento/module-cms": "*",
        "magento/module-config": "*",
        "magento/module-customer": "*",
        "magento/module-eav": "*",
        "magento/module-integration": "*",
        "magento/module-sales": "*",
        "magento/module-sales-rule": "*",
        "magento/module-store": "*",
        "magento/module-ui": "*",
        "magento/module-url-rewrite": "*",
        "magento/module-user": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\AdminActionLog\\": ""
